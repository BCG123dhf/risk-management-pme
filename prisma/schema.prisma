generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DIRECTOR
  RISK_MANAGER
  CONTROL_MANAGER
  COMPLIANCE_OFFICER
  AUDITOR
  USER
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskProbability {
  LOW
  MEDIUM
  HIGH
}

enum RiskImpact {
  LOW
  MEDIUM
  HIGH
}

enum RiskTreatment {
  REDUCE
  ACCEPT
  TRANSFER
  AVOID
}

enum ControlFrequency {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReportType {
  RISK_SUMMARY
  CONTROL_STATUS
  INCIDENT_REPORT
  DIRECTOR_REPORT
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String?
  role         Role        @default(USER)
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  risksOwned     Risk[]      @relation("RiskOwner")
  controlsOwned  Control[]   @relation("ControlOwner")
  actionsOwned   Action[]    @relation("ActionOwner")
  incidentsOwned Incident[] @relation("IncidentOwner")
  auditLogs      AuditLog[]
  reportsCreated Report[]
}

model Department {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  users     User[]
  risks     Risk[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RiskCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  risks     Risk[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Risk {
  id              String          @id @default(cuid())
  title           String
  description     String?
  categoryId      String
  category        RiskCategory    @relation(fields: [categoryId], references: [id])
  departmentId    String?
  department      Department?     @relation(fields: [departmentId], references: [id])
  probability     RiskProbability
  impact          RiskImpact
  level           RiskLevel
  treatment       RiskTreatment
  ownerId         String?
  owner           User?           @relation("RiskOwner", fields: [ownerId], references: [id])
  status          String          @default("OPEN")
  likelihoodScore Int?
  riskScore       Int?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  controls  Control[]
  incidents Incident[]
  actions   Action[]
  auditLogs AuditLog[]
}

model Control {
  id             String            @id @default(cuid())
  title          String
  description    String?
  riskId         String
  risk           Risk              @relation(fields: [riskId], references: [id])
  frequency      ControlFrequency
  ownerId        String?
  owner          User?             @relation("ControlOwner", fields: [ownerId], references: [id])
  status         String            @default("ACTIVE")
  effectiveness  Float?
  nextReviewDate DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  tests ControlTest[]
}

model ControlTest {
  id        String   @id @default(cuid())
  controlId String
  control   Control  @relation(fields: [controlId], references: [id])
  testDate  DateTime
  result    String
  notes     String?
  passed    Boolean
  createdAt DateTime @default(now())
}

model Incident {
  id          String          @id @default(cuid())
  title       String
  description String?
  riskId      String?
  risk        Risk?           @relation(fields: [riskId], references: [id])
  severity    IncidentSeverity
  occurredAt  DateTime
  ownerId     String?
  owner       User?           @relation("IncidentOwner", fields: [ownerId], references: [id])
  status      String          @default("OPEN")
  rootCause   String?
  impact      String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  actions Action[]
}

model Action {
  id          String       @id @default(cuid())
  title       String
  description String?
  riskId      String?
  risk        Risk?        @relation(fields: [riskId], references: [id])
  incidentId  String?
  incident    Incident?    @relation(fields: [incidentId], references: [id])
  ownerId     String?
  owner       User?        @relation("ActionOwner", fields: [ownerId], references: [id])
  priority    ActionPriority
  status      ActionStatus
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  title       String
  type        ReportType
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  generatedAt DateTime  @default(now())
  content     String?
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  riskId    String?
  risk      Risk?    @relation(fields: [riskId], references: [id])
  action    String
  metadata  String?
  createdAt DateTime @default(now())
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
